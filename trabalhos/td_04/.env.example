# Configuração do RabbitMQ compartilhada por Consultas, Estoque e docker compose.
# Copie para .env:  Copy-Item .env.example .env
# Variáveis de ambiente com o mesmo nome têm prioridade sobre este arquivo.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=clinica
RABBITMQ_PASSWORD=clinica123
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=estoque.baixas
